# Every variable below is required at startup — config.ts will throw if any are missing.
# Replace placeholder UUIDs with your real YNAB ids before running.

# --- YNAB ---
# Personal Access Token
YNAB_TOKEN=

# Budget id
YNAB_BUDGET_ID=00000000-0000-0000-0000-000000000000

# JSON object of allowlisted account ids. Keys are documentation; values matter.
ALLOWED_ACCOUNT_IDS={"example_card":"11111111-1111-1111-1111-111111111111"}

# --- Workflow ---
# Days back to scan for new transactions (overridable via --lookback-days). Bump
# higher (e.g. 14) if you ever go more than a few days without running the job.
LOOKBACK_DAYS=3

# JSONL audit log directory (relative paths resolve from CWD)
AUDIT_DIR=audit

# Category groups to drop from the prompt (YNAB API returns them, but the LLM
# shouldn't pick from them). JSON array of strings.
EXCLUDED_CATEGORY_GROUPS=["Credit Card Payments"]

# Routing nudges fed to the LLM. JSON array of strings — each becomes a numbered
# rule in the prompt. Use these to teach the model how YOUR categories map to
# common purchases. Phrasing is loose; the LLM matches on intent.
# Example: ["Pet items go to \"Pet Care\".", "Coffee goes to \"Dining Out\"."]
CATEGORY_ROUTING_HINTS=[]

# --- Anthropic ---
# API key — get one at https://console.anthropic.com (separate from Claude Pro).
ANTHROPIC_API_KEY=

# Model id. Haiku 4.5 is cheap and accurate enough for this classification task.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Notify ---
# Recipient for the daily error-digest email. Sent from the authenticated Gmail
# account (see Gmail block below); From-address is implicit.
NOTIFY_TO_EMAIL=

# --- Stalled Tasks ---
# Recipient for the weekly task-review email (likely same as NOTIFY_TO_EMAIL).
STALLED_TASKS_TO_EMAIL=
# When the digest runs — JSON array of "<Day> HH:MM" (24-hour; day case-insensitive). Each
# entry becomes a launchd trigger, so multiple days/times are fine. Re-run launchd/setup.sh
# after changing it.
STALLED_TASKS_SCHEDULE=["Sunday 08:00", "Wednesday 18:00"]
# Max items shown in the action list.
DIGEST_MAX_ITEMS=5
# A task counts as stale once it's older than this many days (by creation date). Editing a
# task doesn't reset the clock — delete and recreate to reset.
STALE_THRESHOLD_DAYS=30
# Reminders lists to read; JSON array of names. [] = all lists.
REMINDERS_LISTS=[]
# Anthropic model — stronger than ynab-categorize's; this is real judgment, not a lookup.
STALLED_TASKS_MODEL=claude-sonnet-4-6

# --- Gmail (shared by notify, ynab-enrich-memos, and stalled-tasks) ---
# OAuth client id / secret from your GCP project's Credentials page (Desktop type).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Long-lived refresh token. Generate once with:
#   pnpm --filter @personal-automation/gmail bootstrap
# Walks you through Google's consent screen in a browser and prints a token to paste here.
GMAIL_OAUTH_REFRESH_TOKEN=
