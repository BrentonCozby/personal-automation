# tasks config. Shared secrets (ANTHROPIC_API_KEY, Gmail OAuth) live in
# the monorepo-root .env.

# Recipient for the task-review digest (likely same as NOTIFY_TO_EMAIL).
TASKS_TO_EMAIL=

# When the digest runs — JSON array of "<Day> HH:MM" (24-hour; day case-insensitive). Each
# entry becomes a launchd trigger, so multiple days/times are fine. Re-run launchd/setup.sh
# after changing it.
TASKS_SCHEDULE=["Sunday 08:00", "Wednesday 18:00"]

# How many tasks may carry #active at once. `tasks promote --over-cap` raises it for one run.
TASKS_WIP_CAP=3

# Days an #active task can go untouched before it counts as stalled. Editing the task or its
# notes counts as a touch.
TASKS_STALL_DAYS=7

# How far ahead you can honestly see, in days. Both the decay threshold and the ceiling on
# scheduling a task read this one number: a date past it means #someday, not a plan.
TASKS_HORIZON_DAYS=28

# Files or folders in the vault that hold tasks; JSON array of paths relative to the vault root,
# a folder being walked for its *.md files ([] = just todos.md at the vault root). Every command
# reads this same setting.
TASK_LISTS=[]

# Absolute path to the Obsidian vault folder on disk. Keep it synced separately (Obsidian Sync or
# the Obsidian Git plugin). Keep it out of ~/Documents, ~/Desktop, and ~/Downloads — macOS blocks
# the launchd backup from reading those folders. A path directly under your home folder works.
OBSIDIAN_VAULT_PATH=/Users/you/your-vault

# Anthropic model — stronger than ynab-categorize's; this is real judgment, not a lookup.
TASKS_ANTHROPIC_MODEL=claude-sonnet-5
