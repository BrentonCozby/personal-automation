# tasks config. Shared secrets (ANTHROPIC_API_KEY, Gmail OAuth) live in
# the monorepo-root .env.

# Recipient for the task-review digest (likely same as NOTIFY_TO_EMAIL).
TASKS_TO_EMAIL=

# When the digest runs: JSON array of "<Day> HH:MM" (24-hour; day case-insensitive). Each
# entry becomes a launchd trigger, so multiple days/times are fine. Re-run launchd/setup.sh
# after changing it.
TASKS_SCHEDULE=["Sunday 08:00", "Wednesday 18:00"]

# How many tasks may carry #active at once. `tasks promote --over-cap` raises it for one run.
TASKS_WIP_CAP=3

# Days an #active task can go untouched before it counts as stalled. Editing the task or its
# notes counts as a touch.
TASKS_STALL_DAYS=7

# How far ahead you can honestly see, in days. Both the decay threshold and the ceiling on
# scheduling a task read this one number: a date past it means #someday, not a plan.
TASKS_HORIZON_DAYS=28

# Files or folders in the vault that hold tasks; JSON array of paths relative to the vault root,
# a folder being walked for its *.md files ([] = just todos.md at the vault root). Every command
# reads this same setting.
TASK_LISTS=[]

# Absolute path to the Obsidian vault folder on disk. Keep it synced separately (Obsidian Sync or
# the Obsidian Git plugin). Keep it out of ~/Documents, ~/Desktop, and ~/Downloads, since macOS blocks
# the launchd backup from reading those folders. A path directly under your home folder works.
OBSIDIAN_VAULT_PATH=/Users/you/your-vault

# Anthropic model, stronger than ynab-categorize's; this is real judgment, not a lookup.
TASKS_ANTHROPIC_MODEL=claude-sonnet-5

# How many days of finished and dropped tasks the review's done list covers, counting today. A
# separate claim from the stall window: that one is how long silence is tolerable, this is how far
# back a record of what you did stays interesting.
TASKS_DONE_WINDOW_DAYS=7

# A cap you keep going around is a cap set too low. More than TASKS_OVERRIDE_LIMIT raises
# (promote --over-cap) inside TASKS_OVERRIDE_WINDOW_DAYS days, and the review suggests raising
# TASKS_WIP_CAP for good. Raising it clears the count, because only raises recorded against the cap
# now in force are counted.
TASKS_OVERRIDE_WINDOW_DAYS=30
TASKS_OVERRIDE_LIMIT=3

# Days a dated one-off task keeps being pushed about, counting the due day. After that the
# twice-weekly review takes over. Recurring (🔁) tasks ignore this: an unticked chore is asked
# about every day it is late, because the Tasks plugin only rolls its date forward on the tick.
TASKS_DUE_ALERT_DAYS=7

# When the due-date alert runs: JSON array of "HH:MM" (24-hour), every day. The morning pass is
# easy to dismiss half-asleep, so the evening one names what is still not done. Re-run
# launchd/setup.sh after changing it.
TASKS_ALERT_TIMES=["08:00", "19:00"]

# Where tapping the push lands. The dashboard rather than todos.md, because that is the view
# actually read, and opening Obsidian puts the other active tasks in front of you.
TASKS_ALERT_URL=obsidian://open?vault=<your vault name>&file=<your dashboard>.md
