# Where the Claude Code hooks append events, and where the board keeps your
# annotations. Both are absolute: the hook runs from whatever directory the
# session is in, so a relative path would land somewhere different every time.
BOARD_EVENT_LOG=/Users/you/.claude-board/events.jsonl
BOARD_METADATA_FILE=/Users/you/.claude-board/sessions.json

BOARD_PORT=4747

# A row's age is called out past this many days. Four is about how long a
# healthy session goes untouched, so older than that is genuinely neglected.
BOARD_STALE_DAYS=4

# A session that went idle within this many minutes reads as "finished, your
# move" rather than dropping to the muted color.
BOARD_FRESH_MINUTES=15

# What runs inside the new tab when you click resume. {{id}} is the session id.
# Resume by id, not by name: an id resolves from any directory as of Claude Code
# v2.1.223, while a name only resolves within the session's own repository.
#
# Run it through a login shell. Ghostty starts the command as
# `bash --noprofile --norc -c 'exec -l <command>'`, so it gets the bare PATH from
# login(1): no ~/.local/bin, and no shell aliases either, since aliases do not
# exist in a non-interactive shell. A bare `claude` fails there with
# "claude: not found" even though it works when you type it.
#
# The tab itself is opened through Ghostty's AppleScript dictionary, which is in
# the code rather than here. `open -na Ghostty` is the documented CLI route on
# macOS but it is wrong for this: it starts a second Ghostty application
# alongside yours instead of adding a tab to the window you already have, and it
# ignores --working-directory.
BOARD_LAUNCH_COMMAND=/bin/zsh -lc "claude --resume {{id}}"

# Runs when you click a progress-file slug. {{path}} is the file. Split on
# spaces and run directly, with no shell in between.
BOARD_OPEN_FILE_COMMAND=code -- {{path}}

# Resume, for a row that has a progress file: rather than reopening the old
# conversation, start a clean session under the same name and point it at the
# file. The progress file is the durable state, so a fresh session that reads it
# starts where you left off without carrying a long stale context.
#
# {{name}} and {{prompt}} are both shell-quoted before substitution, so a
# session name holding an apostrophe or a space is safe here. Write the template
# without quotes of your own around them.
#
# The finished command is written to a script file and run as `zsh -l <file>`
# rather than passed to Ghostty as a string, because that string would otherwise
# cross two shells with different quoting rules.
BOARD_PROGRESS_COMMAND=claude-auto -n {{name}} {{prompt}}

# What that new session is told first. {{progress}} is the file's absolute path.
BOARD_PROGRESS_PROMPT=Read {{progress}} for where this work stands, then carry on with it. Run `git fetch --prune --tags` before you trust the file or the local git refs: both go stale in the same direction.

# Where Claude Code keeps transcripts, comma separated. A session with no
# transcript in any of these cannot be resumed, so the board says so instead of
# offering a button that opens an empty tab. List one per account: claude-auto
# routes work repositories to one config directory and everything else to
# another, and a session's transcript only exists under the one it ran as.
BOARD_TRANSCRIPT_ROOTS=/Users/you/.claude/projects,/Users/you/.claude-personal/projects
