# ynab-enrich-memos config. Shared secrets and ids (YNAB_TOKEN, YNAB_BUDGET_ID,
# ALLOWED_ACCOUNT_IDS, ANTHROPIC_API_KEY, Gmail OAuth) live in the monorepo-root .env.

# Days back to scan for transactions to enrich (overridable via --lookback-days).
ENRICH_LOOKBACK_DAYS=5

# ± window (days) around a transaction's date to search Gmail for its receipt. A wider
# window catches receipts that post a few days off the charge; too wide invites mismatches.
GMAIL_RECEIPT_WINDOW_DAYS=5

# Amazon sender addresses receipts arrive from. JSON array of strings, OR-ed together in
# the Gmail query. Reading Gmail uses the readonly scope already granted at bootstrap.
GMAIL_FROM_FILTER=["auto-confirm@amazon.com","shipment-tracking@amazon.com"]

# Model id. Haiku 4.5 is cheap and handles receipt extraction well; bump to a stronger
# model if item-matching accuracy is poor in practice.
ENRICH_MEMOS_ANTHROPIC_MODEL=claude-haiku-4-5
