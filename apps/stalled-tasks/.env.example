# stalled-tasks config. Shared secrets (ANTHROPIC_API_KEY, Gmail OAuth) live in
# the monorepo-root .env.

# Recipient for the task-review digest (likely same as NOTIFY_TO_EMAIL).
STALLED_TASKS_TO_EMAIL=

# When the digest runs — JSON array of "<Day> HH:MM" (24-hour; day case-insensitive). Each
# entry becomes a launchd trigger, so multiple days/times are fine. Re-run launchd/setup.sh
# after changing it.
STALLED_TASKS_SCHEDULE=["Sunday 08:00", "Wednesday 18:00"]

# Max items shown in the action list.
DIGEST_MAX_ITEMS=5

# A task counts as stale once it's older than this many days (by creation date). Editing a
# task doesn't reset the clock — delete and recreate to reset.
STALE_THRESHOLD_DAYS=30

# Which backend to read tasks from: "obsidian" (Markdown todos in a vault on disk) or "google"
# (Google Tasks — not implemented yet). Switching providers is a config change only.
TASK_PROVIDER=obsidian

# Task lists to read; JSON array. obsidian: file/folder paths relative to the vault root, a folder
# being walked for its *.md files ([] = just todos.md).
TASK_LISTS=[]

# Only for TASK_PROVIDER=obsidian: absolute path to the vault folder on disk (read-only; keep it
# synced separately via Obsidian Sync or the Obsidian Git plugin). Leave unset for other providers.
# Keep it out of ~/Documents, ~/Desktop, and ~/Downloads — macOS blocks the launchd backup from
# reading those folders. A path directly under your home folder works.
# OBSIDIAN_VAULT_PATH=/Users/you/your-vault

# Anthropic model — stronger than ynab-categorize's; this is real judgment, not a lookup.
STALLED_TASKS_ANTHROPIC_MODEL=claude-sonnet-4-6
