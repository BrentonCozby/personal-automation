{
  "name": "personal-automation",
  "version": "0.1.0",
  "description": "Personal automation monorepo: small scheduled jobs and the shared libraries they build on.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=26.8.2",
    "pnpm": ">=11.27.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^25.9.7",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,json,md}": "biome check --write --no-errors-on-unmatched"
  }
}
