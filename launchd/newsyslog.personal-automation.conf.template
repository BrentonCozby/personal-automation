# Rotate the launchd jobs' stdout/stderr logs so they don't grow forever.
# Generated by launchd/setup.sh from this template with the project's absolute path
# and the current user's username substituted in.
#
# Install once with:
#   sudo cp launchd/newsyslog.personal-automation.conf /etc/newsyslog.d/
#
# Format: logfilename owner:group mode count size when flags
#   count=4    keep 4 archived versions
#   size=1024  rotate when the file exceeds 1024 KB
#   when=$W0   also rotate on Sunday (weekly)
#   flags=Z    gzip the archives

{{PROJECT_DIR}}/launchd/logs/daily.out.log           {{USERNAME}}:staff  644  4  1024  $W0  Z
{{PROJECT_DIR}}/launchd/logs/daily.err.log           {{USERNAME}}:staff  644  4  1024  $W0  Z
{{PROJECT_DIR}}/launchd/logs/tasks-digest.out.log   {{USERNAME}}:staff  644  4  1024  $W0  Z
{{PROJECT_DIR}}/launchd/logs/tasks-digest.err.log   {{USERNAME}}:staff  644  4  1024  $W0  Z
{{PROJECT_DIR}}/launchd/logs/tasks-alert.out.log    {{USERNAME}}:staff  644  4  1024  $W0  Z
{{PROJECT_DIR}}/launchd/logs/tasks-alert.err.log    {{USERNAME}}:staff  644  4  1024  $W0  Z
{{PROJECT_DIR}}/launchd/logs/vault-backup.out.log    {{USERNAME}}:staff  644  4  1024  $W0  Z
{{PROJECT_DIR}}/launchd/logs/vault-backup.err.log    {{USERNAME}}:staff  644  4  1024  $W0  Z
{{PROJECT_DIR}}/launchd/logs/session-board.out.log   {{USERNAME}}:staff  644  4  1024  $W0  Z
{{PROJECT_DIR}}/launchd/logs/session-board.err.log   {{USERNAME}}:staff  644  4  1024  $W0  Z
